{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Lamassu Helm chart values",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "commonLabels": { "$ref": "#/definitions/stringMap" },
    "commonAnnotations": { "$ref": "#/definitions/stringMap" },
    "global": {
      "type": "object",
      "properties": {
        "imagePullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "imagePullSecrets": { "$ref": "#/definitions/imagePullSecrets" }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "automountServiceAccountToken": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "tls": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["certManager", "external"] },
        "certManagerOptions": { "type": "object" },
        "externalOptions": { "type": "object" }
      },
      "additionalProperties": false
    },
    "gateway": {
      "type": "object",
      "required": ["className", "ports"],
      "properties": {
        "className": { "type": "string", "minLength": 1 },
        "extraRouting": { "type": ["array", "null"] },
        "addresses": { "type": ["array", "null"] },
        "ports": {
          "type": "object",
          "required": ["http", "https"],
          "properties": {
            "http": { "$ref": "#/definitions/port" },
            "https": { "$ref": "#/definitions/port" }
          },
          "additionalProperties": false
        },
        "responseOverride": { "type": "object" }
      },
      "additionalProperties": false
    },
    "postgres": {
      "type": "object",
      "properties": {
        "hostname": { "type": "string" },
        "port": { "$ref": "#/definitions/port" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "logLevel": { "type": "string" }
      },
      "additionalProperties": false
    },
    "amqp": {
      "type": "object",
      "properties": {
        "hostname": { "type": "string" },
        "port": { "$ref": "#/definitions/port" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "tls": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "observability": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "routes": { "type": "object" },
        "traces": { "type": "object" },
        "logs": { "type": "object" }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "oidc": { "type": "object" },
        "authorization": { "type": "object" },
        "externalAuthorization": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "serviceName": { "type": "string" },
            "servicePort": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
            "path": { "type": "string", "pattern": "^/" },
            "failOpen": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "serviceDefaults": {
      "allOf": [
        { "$ref": "#/definitions/service" },
        { "required": ["port", "replicaCount", "resources", "livenessProbe", "readinessProbe", "startupProbe", "autoscaling", "pdb"] }
      ]
    },
    "services": {
      "type": "object",
      "properties": {
        "ui": { "$ref": "#/definitions/service" },
        "va": { "$ref": "#/definitions/service" },
        "ca": { "$ref": "#/definitions/service" },
        "kms": { "$ref": "#/definitions/service" },
        "deviceManager": { "$ref": "#/definitions/service" },
        "dmsManager": {
          "allOf": [
            { "$ref": "#/definitions/service" },
            {
              "type": "object",
              "properties": {
                "tlsInitContainer": {
                  "type": "object",
                  "properties": {
                    "image": { "type": "string", "minLength": 1 },
                    "securityContext": { "$ref": "#/definitions/containerSecurityContext" }
                  },
                  "additionalProperties": false
                }
              }
            }
          ]
        },
        "alerts": { "$ref": "#/definitions/service" },
        "authz": { "$ref": "#/definitions/service" },
        "wfx": {
          "allOf": [
            { "$ref": "#/definitions/service" },
            {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "clientPort": { "$ref": "#/definitions/port" },
                "managementPort": { "$ref": "#/definitions/port" },
                "extraArgs": { "type": "array", "items": { "type": "string" } }
              }
            }
          ]
        },
        "connectors": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" },
          "additionalProperties": {
            "allOf": [
              { "$ref": "#/definitions/service" },
              {
                "type": "object",
                "required": ["type", "image"],
                "properties": {
                  "type": { "type": "string", "minLength": 1 },
                  "securityContext": { "$ref": "#/definitions/connectorSecurityContext" }
                }
              }
            ]
          }
        }
      },
      "required": ["ui", "va", "ca", "kms", "deviceManager", "dmsManager", "alerts", "authz", "wfx", "connectors"],
      "additionalProperties": false
    },
    "connectivityTest": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "securityContext": { "$ref": "#/definitions/containerSecurityContext" }
      },
      "additionalProperties": false
    },
    "migrations": {
      "type": "object",
      "properties": {
        "db": {
          "type": "object",
          "required": ["image", "databases"],
          "properties": {
            "image": { "type": "string", "minLength": 1 },
            "databases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "caToKms": {
          "type": "object",
          "required": ["enabled", "image"],
          "properties": {
            "enabled": { "type": "boolean" },
            "image": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "required": ["db", "caToKms"],
      "additionalProperties": false
    }
  },
  "required": ["global", "serviceAccount", "tls", "gateway", "postgres", "amqp", "auth", "serviceDefaults", "services", "connectivityTest", "migrations"],
  "additionalProperties": false,
  "definitions": {
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "type": "string", "minLength": 1 } },
            "additionalProperties": false
          }
        ]
      }
    },
    "probe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "pattern": "^/" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "pdb": {
      "type": "object",
      "properties": {
        "minAvailable": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string", "pattern": "^[0-9]+%$" }
          ]
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "port": { "$ref": "#/definitions/port" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "podLabels": { "$ref": "#/definitions/stringMap" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "imagePullSecrets": { "$ref": "#/definitions/imagePullSecrets" },
        "podSecurityContext": { "$ref": "#/definitions/podSecurityContext" },
        "securityContext": { "$ref": "#/definitions/containerSecurityContext" },
        "extraEnv": { "type": "array" },
        "command": { "type": "array", "items": { "type": "string" } },
        "args": { "type": "array", "items": { "type": "string" } },
        "livenessProbe": { "$ref": "#/definitions/probe" },
        "readinessProbe": { "$ref": "#/definitions/probe" },
        "startupProbe": { "$ref": "#/definitions/probe" },
        "autoscaling": { "$ref": "#/definitions/autoscaling" },
        "affinity": { "type": "object" },
        "topologySpreadConstraints": { "type": "array" },
        "pdb": { "$ref": "#/definitions/pdb" }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "drop": { "type": "array", "items": { "type": "string" } },
        "add": { "type": "array", "items": { "type": "string" }, "maxItems": 0 }
      },
      "additionalProperties": false
    },
    "containerSecurityContext": {
      "type": "object",
      "properties": {
        "runAsNonRoot": { "type": "boolean" },
        "runAsUser": { "type": "integer", "minimum": 0 },
        "runAsGroup": { "type": "integer", "minimum": 0 },
        "allowPrivilegeEscalation": { "const": false },
        "readOnlyRootFilesystem": { "type": "boolean" },
        "capabilities": { "$ref": "#/definitions/capabilities" },
        "seccompProfile": { "type": "object" }
      },
      "additionalProperties": false
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsNonRoot": { "type": "boolean" },
        "runAsUser": { "type": "integer", "minimum": 0 },
        "runAsGroup": { "type": "integer", "minimum": 0 },
        "fsGroup": { "type": "integer", "minimum": 0 },
        "fsGroupChangePolicy": { "type": "string", "enum": ["OnRootMismatch", "Always"] },
        "supplementalGroups": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "seccompProfile": { "type": "object" }
      },
      "additionalProperties": false
    },
    "connectorSecurityContext": {
      "allOf": [
        { "$ref": "#/definitions/containerSecurityContext" },
        {
          "type": "object",
          "properties": {
            "runAsNonRoot": { "const": true },
            "runAsUser": { "type": "integer", "minimum": 1 },
            "runAsGroup": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    }
  }
}
