# The p11-kit server version comes from this base image and must be
# RPC-compatible with the KMS p11-kit-client.so (mixed minor versions fail with
# CKR_DEVICE_MEMORY). Bump it together with the pkcs11-client-proxy stage of
# lamassuiot ci/kms.dockerfile and the p11-kit-client staging image in
# charts/lamassu/ci/pkcs11-incluster-hsm-values.yaml and the fast-lane script.
FROM ubuntu:26.04

RUN apt-get update && apt-get install -y \
    git \
    automake \
    autoconf \
    libtool \
    pkg-config \
    build-essential \
    libssl-dev \
    sqlite3 \
    libsqlite3-dev \
    cmake \
    libseccomp-dev \
    openssh-server \
    p11-kit \
    p11-kit-modules

# Builging sfthsmv2/installing
RUN git clone https://github.com/opendnssec/SoftHSMv2.git && \
    cd SoftHSMv2 && \
    sh autogen.sh && \
    ./configure --disable-non-paged-memory --with-objectstore-backend-db && \
    make && \
    make install && \
    mkdir -p /softhsm/tokens
    # cp src/bin/util/softhsm2-util /usr/bin/ && \
    # mkdir -p /usr/local/lib/softhsm && \
    # cp -p src/lib/.libs/libsofthsm2.so /usr/local/lib/softhsm/libsofthsm2.so

# Install pkcs11-tool
RUN apt-get install -y opensc 

RUN mkdir -p /var/run/sshd

COPY start.sh /app/start.sh
RUN chmod +x /app/start.sh

# SoftHSM only logs into Syslog. We need to run a syslog daemon to capture the logs
RUN apt-get install syslog-ng -y

EXPOSE 22

ENTRYPOINT  [ "/app/start.sh" ]